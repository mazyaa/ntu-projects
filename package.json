{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "prepare": "husky",
    "lint": "npm run lint:secrets && npm run lint:php && npm run lint:css",
    "lint:secrets": "node scripts/check-secrets.mjs --all",
    "lint:php": "php vendor/bin/pint --test",
    "lint:css": "node scripts/check-tailwind.mjs"
  },
  "lint-staged": {
    "*.php": "php vendor/bin/pint --test"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.4.2",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.0.1",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^3.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "apexcharts": "^6.6.1",
    "countup.js": "^2.10.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide": "^1.27.0",
    "notyf": "^3.10.0",
    "sweetalert2": "^11.26.25",
    "swiper": "^14.0.7",
    "typed.js": "^3.0.0"
  }
}
